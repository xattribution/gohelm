diff --git a/browsertools.go b/browsertools.go
new file mode 100644
index 0000000..b93737f
--- /dev/null
+++ b/browsertools.go
@@ -0,0 +1,291 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/xattribution/gohelm"
+	"github.com/xattribution/gohelm/policy"
+)
+
+// The browser (beta, under Superuser): the SI uses web sites in a window of
+// Quartermaster's own, with the gohelm module. The window is Microsoft Edge
+// WebView2 with a profile of its own (in this computer's local folder,
+// never in OneDrive), driven only through WebView2's own DevTools API, so
+// no debugging port opens and Edge's remote-debugging policy doesn't apply.
+//
+// What the SI may do there:
+//   - Sites: only those the deployment file lists ("browser": {"allow",
+//     "read_only", "block"}); with Superuser on, others ask first on a card.
+//     This computer's own addresses, private addresses and anything but
+//     https never open.
+//   - Reading: snapshots and text, with text styled to be invisible and
+//     frames from other sites left out. Everything read is outside content
+//     (outsideTools): it reaches the model as data, and facts from it wait
+//     for the user's Keep.
+//   - Acting: clicks, fields and keys. Anything that sends, submits, buys,
+//     deletes, signs or agrees, and anything a page tries to send after an
+//     action, stops at a card the user answers ("browser" Ask). Passwords,
+//     PINs, codes and ID numbers are never typed; the SI hands those to the
+//     user (browser_hand_over).
+//   - A CAC sign-in: when the page's own site asks for the user's
+//     certificate, WebView2 shows its own picker and Windows its own PIN
+//     prompt. Quartermaster never chooses a certificate and never sees the
+//     PIN.
+//   - Downloads, uploads, permission prompts and pop-up windows are refused
+//     (pop-ups open in the same window after the same checks).
+//
+// With Superuser on, the Full profile adds an outside Edge or Chrome with
+// its own profile and other programs on this computer through UI
+// Automation (Settings lists which programs; none by default).
+
+const browserMarker = "[needs browser OK]"
+
+// browserOn says the browser tools may be offered: under Superuser (the
+// Full profile), or where the deployment file turns on the "browser"
+// feature (the pane only, on the sites it lists).
+func (app *App) browserOn() bool {
+	return superuserOn(app.store.Config()) && app.betaAllowed() || app.feature("browser")
+}
+
+var (
+	browserMu   sync.Mutex
+	browserSess *gohelm.Session
+	browserFull bool
+)
+
+// browserRules are the site rules: the deployment file's, and under
+// Superuser asking about sites on no list.
+func (app *App) browserRules(full bool) policy.Rules {
+	_, d := readDeploy()
+	var r policy.Rules
+	if d.Browser != nil {
+		r = *d.Browser
+	}
+	if full && d.Browser == nil {
+		r.AskOutside = true
+	}
+	if !full {
+		r.Desktop = policy.DesktopRules{} // other programs are Full only
+	}
+	return r
+}
+
+// browserSession is the browser state the tools share, made on first use
+// and made again when Superuser changes the profile.
+func (app *App) browserSession() (*gohelm.Session, error) {
+	full := superuserOn(app.store.Config())
+	browserMu.Lock()
+	defer browserMu.Unlock()
+	if browserSess != nil && browserFull == full {
+		*browserSess.Rules() = app.browserRules(full)
+		return browserSess, nil
+	}
+	if browserSess != nil {
+		browserSess.Close()
+		browserSess = nil
+	}
+	prof := gohelm.Pane
+	if full {
+		prof = gohelm.Full
+	}
+	s, err := gohelm.New(gohelm.Config{
+		Profile:       prof,
+		Rules:         app.browserRules(full),
+		PaneDir:       filepath.Join(app.store.paths.Local, "browser"),
+		PaneTitle:     appName + " browser",
+		PaneOwner:     appWindowHandle(),
+		BrowserDir:    filepath.Join(app.store.paths.Local, "browser-outside"),
+		AgentName:     appName,
+		WorkingStatus: appName + " is working",
+	})
+	if err != nil {
+		return nil, err
+	}
+	browserSess, browserFull = s, full
+	return s, nil
+}
+
+// browserTools are gohelm's tools as Quartermaster's. The list is the Full
+// profile's; what a chat is offered follows the profile in force.
+func browserTools() []toolDef {
+	s, _ := gohelm.New(gohelm.Config{Profile: gohelm.Full})
+	var out []toolDef
+	for _, t := range s.Tools() {
+		name := t.Name
+		out = append(out, toolDef{
+			name: name, label: t.Label, desc: t.Description, params: t.Params, required: t.Required,
+			needs: "browser", readOnly: t.ReadOnly,
+			fn: func(r *Run, a args) (toolResult, error) { return r.runBrowserTool(name, a) },
+		})
+	}
+	return out
+}
+
+// browserFullOnly are the tools only the Full profile has.
+var browserFullOnly = map[string]bool{"browser_tabs": true, "desktop_windows": true, "desktop_snapshot": true, "desktop_act": true}
+
+func (r *Run) runBrowserTool(name string, a args) (toolResult, error) {
+	app := r.app
+	if !app.browserOn() {
+		return toolResult{}, fmt.Errorf("the browser is off: it's a beta under Superuser, or a feature the deployment file turns on")
+	}
+	s, err := app.browserSession()
+	if err != nil {
+		return toolResult{}, err
+	}
+	var tool *gohelm.Tool
+	for _, t := range s.Tools() {
+		if t.Name == name {
+			t := t
+			tool = &t
+		}
+	}
+	if tool == nil {
+		return toolResult{}, fmt.Errorf("%s isn't available in this build", name)
+	}
+	lead := r
+	for lead.parent != nil {
+		lead = lead.parent
+	}
+	env := policy.Env{
+		Gate:  qmBrowserGate{r},
+		Owner: lead.chatID,
+		Audit: policy.AuditFunc(func(e policy.Event) {
+			out := e.Outcome
+			if e.Phase == "intent" {
+				out = "intent"
+			}
+			app.audit.write(auditRec{Ev: "browser", Chat: lead.chatID, Helper: r.parent != nil, Tool: e.Tool,
+				Effect: strings.TrimSpace(e.Action + " " + e.Class), Kind: e.Origin, Out: out})
+		}),
+	}
+	res, err := tool.Run(r.ctx, env, gohelm.Args(a))
+	if err != nil {
+		return toolResult{}, err
+	}
+	text := res.Text
+	if res.Pending != nil {
+		text = browserMarker + " " + text
+	}
+	return toolResult{text: text, summary: res.Summary}, nil
+}
+
+// qmBrowserGate asks the way a zip card does (zipgate.go): the question
+// stops the turn at a card, the call runs again after the click, and an
+// answer is used once. Recipe runs, scheduled runs, Chat from Teams and
+// helpers can't ask.
+type qmBrowserGate struct{ r *Run }
+
+func (g qmBrowserGate) Decide(_ context.Context, a policy.Ask) (policy.Answer, error) {
+	r := g.r
+	lead := r
+	for lead.parent != nil {
+		lead = lead.parent
+	}
+	fg := lead.gate
+	if fg == nil || fg.placeNoCard || r.parent != nil {
+		return policy.CannotAsk, nil
+	}
+	fg.mu.Lock()
+	defer fg.mu.Unlock()
+	if said, ok := fg.browserSaid[a.Key]; ok {
+		delete(fg.browserSaid, a.Key) // one answer, one use
+		switch said {
+		case "allow":
+			return policy.Allow, nil
+		case "allow_site":
+			return policy.AllowSite, nil
+		case "done":
+			return policy.Done, nil
+		}
+		return policy.Deny, nil
+	}
+	if fg.browser == nil {
+		a := a
+		fg.browser = &a
+	}
+	return policy.Pending, nil
+}
+
+// takeBrowserAsk is the question a browser tool asked this round, if any.
+func (r *Run) takeBrowserAsk() *policy.Ask {
+	if r.gate == nil {
+		return nil
+	}
+	r.gate.mu.Lock()
+	defer r.gate.mu.Unlock()
+	a := r.gate.browser
+	r.gate.browser = nil
+	return a
+}
+
+// The card's buttons, by the option gohelm gave.
+var browserOptLabels = map[policy.Option]string{
+	policy.OptAllow:     "Allow",
+	policy.OptAllowSite: "Allow for this site",
+	policy.OptDeny:      "Don't allow",
+	policy.OptDone:      "I'm done",
+}
+
+// browserAsk is the card, with the calls to run once it's answered.
+func browserAsk(a policy.Ask, calls []map[string]any) *Ask {
+	var opts []string
+	for _, o := range a.Options {
+		if l := browserOptLabels[o]; l != "" {
+			opts = append(opts, l)
+		}
+	}
+	text := a.Title
+	if len(a.Detail) > 0 {
+		text += "\n" + strings.Join(a.Detail, "\n")
+	}
+	return &Ask{Kind: "browser", Browser: &a, Pending: calls,
+		Questions: []Question{{ID: "q1", Text: text, Kind: "choice", Options: opts}}}
+}
+
+// browserChoice reads the card's answer: one of gohelm's options, or
+// "notnow" for anything but one of its buttons.
+func browserChoice(ask *Ask, clicked bool) string {
+	if !clicked || ask == nil || ask.Browser == nil || len(ask.Answers) != 1 {
+		return "notnow"
+	}
+	for o, l := range browserOptLabels {
+		if ask.Answers[0] == l {
+			for _, have := range ask.Browser.Options {
+				if have == o {
+					return string(o)
+				}
+			}
+		}
+	}
+	return "notnow"
+}
+
+// resumeBrowser applies the answer to a browser card and runs the calls
+// that waited for it.
+func (app *App) resumeBrowser(ctx context.Context, c *Chat, run *Run, toolMap map[string]toolDef, ask *Ask, clicked bool, msgs []Msg, steps *[]Step, stepsMu *sync.Mutex, lr *liveRun) []Msg {
+	act := browserChoice(ask, clicked)
+	if ask.Browser != nil {
+		run.gate.mu.Lock()
+		if run.gate.browserSaid == nil {
+			run.gate.browserSaid = map[string]string{}
+		}
+		run.gate.browserSaid[ask.Browser.Key] = act
+		run.gate.mu.Unlock()
+		app.audit.write(auditRec{Ev: "browser", Chat: c.ID, Kind: ask.Browser.Origin, Effect: string(ask.Browser.Kind) + " " + act, Out: "answer"})
+	}
+	outs := app.runTools(ctx, run, toolMap, ask.Pending, steps, stepsMu, lr)
+	run.takePlaceAsk()
+	run.takeZipAsk()
+	run.takeBrowserAsk() // another question one of them asked: asked when it's called again
+	for i, tc := range ask.Pending {
+		id, _ := tc["id"].(string)
+		name, _ := tc["function"].(map[string]any)["name"].(string)
+		msgs = append(msgs, Msg{"role": "tool", "tool_call_id": id, "name": name, "content": gateLater(outs[i])})
+	}
+	return msgs
+}
diff --git a/browsertools_test.go b/browsertools_test.go
new file mode 100644
index 0000000..c167557
--- /dev/null
+++ b/browsertools_test.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/xattribution/gohelm/policy"
+)
+
+func browserToolNames(app *App) map[string]bool {
+	_, m := app.toolsFor(nil)
+	out := map[string]bool{}
+	for n := range m {
+		if strings.HasPrefix(n, "browser_") || strings.HasPrefix(n, "desktop_") {
+			out[n] = true
+		}
+	}
+	return out
+}
+
+func TestBrowserToolsOnlyUnderSuperuser(t *testing.T) {
+	app := testApp(t)
+	if got := browserToolNames(app); len(got) != 0 {
+		t.Fatalf("browser tools offered with Superuser off: %v", got)
+	}
+	if _, err := newRun(app, t.Context(), nil).runBrowserTool("browser_snapshot", args{}); err == nil {
+		t.Error("a browser tool ran with Superuser off")
+	}
+	superuserForTest(app)
+	got := browserToolNames(app)
+	for _, n := range []string{"browser_go", "browser_snapshot", "browser_read", "browser_click", "browser_fill", "browser_press",
+		"browser_dialog", "browser_hand_over", "browser_tabs", "desktop_windows", "desktop_snapshot", "desktop_act"} {
+		if !got[n] {
+			t.Errorf("%s not offered under Superuser", n)
+		}
+	}
+}
+
+func TestBrowserToolsAreWiredIn(t *testing.T) {
+	inSet := map[string]bool{}
+	for _, s := range toolSets {
+		for _, n := range s.tools {
+			inSet[n] = true
+		}
+	}
+	for _, d := range browserTools() {
+		if _, ok := toolNotes[d.name]; !ok {
+			t.Errorf("%s has no line in toolNotes", d.name)
+		}
+		if !inSet[d.name] {
+			t.Errorf("%s is in no tool set", d.name)
+		}
+		if outsideTools[d.name] == "" {
+			t.Errorf("%s isn't fenced as outside content", d.name)
+		}
+		if d.readOnly && noteFor(d.name).effect == makes {
+			t.Errorf("%s is read-only but makes something", d.name)
+		}
+	}
+	for _, n := range []string{"browser_click", "browser_fill", "browser_press", "browser_dialog", "desktop_act"} {
+		if noteFor(n).effect != makes {
+			t.Errorf("%s isn't journaled as a change", n)
+		}
+	}
+}
+
+func TestBrowserGateAsksOnceAndCards(t *testing.T) {
+	app := testApp(t)
+	r := newRun(app, t.Context(), nil)
+	ask := policy.Ask{Kind: policy.KindCommit, Key: "commit:abc", Title: `Click button "Submit" on travel.example.mil?`,
+		Detail: []string{"Sends to: https://travel.example.mil/submit (POST)"}, Options: []policy.Option{policy.OptAllow, policy.OptAllowSite, policy.OptDeny}}
+	ctx := context.Background()
+	if a, _ := (qmBrowserGate{r}).Decide(ctx, ask); a != policy.CannotAsk {
+		t.Errorf("a run nobody is in asked: %v", a)
+	}
+	r.gate = &folderGate{}
+	if a, _ := (qmBrowserGate{r}).Decide(ctx, ask); a != policy.Pending {
+		t.Fatalf("no card: %v", a)
+	}
+	got := r.takeBrowserAsk()
+	if got == nil || got.Key != ask.Key {
+		t.Fatalf("the question wasn't kept for the card: %+v", got)
+	}
+	helper := newRun(app, t.Context(), nil)
+	helper.parent = r
+	if a, _ := (qmBrowserGate{helper}).Decide(ctx, ask); a != policy.CannotAsk {
+		t.Errorf("a helper asked: %v", a)
+	}
+	card := browserAsk(*got, nil)
+	if card.Kind != "browser" || len(card.Questions) != 1 || strings.Join(card.Questions[0].Options, "|") != "Allow|Allow for this site|Don't allow" ||
+		!strings.Contains(card.Questions[0].Text, "Sends to:") {
+		t.Errorf("card: %+v", card)
+	}
+	card.Answers = []string{"Allow for this site"}
+	if browserChoice(card, true) != "allow_site" {
+		t.Error("button not read")
+	}
+	if browserChoice(card, false) != "notnow" {
+		t.Error("a typed answer counted as a click")
+	}
+	card.Answers = []string{"I'm done"}
+	if browserChoice(card, true) != "notnow" {
+		t.Error("a button the card didn't have counted")
+	}
+	// The answer is used once.
+	r.gate.browserSaid = map[string]string{ask.Key: "allow"}
+	if a, _ := (qmBrowserGate{r}).Decide(ctx, ask); a != policy.Allow {
+		t.Errorf("answer not used: %v", a)
+	}
+	if a, _ := (qmBrowserGate{r}).Decide(ctx, ask); a != policy.Pending {
+		t.Errorf("answer used twice: %v", a)
+	}
+	if !strings.HasPrefix(gateLater(browserMarker+" waiting"), "Not done yet") {
+		t.Error("gateLater doesn't know the browser's marker")
+	}
+}
